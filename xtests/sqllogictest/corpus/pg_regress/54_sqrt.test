# PG `sqrt(x)` — square root. Negative input → error.

query R
SELECT sqrt(16)
----
4.000

query R
SELECT sqrt(25)
----
5.000

query R
SELECT sqrt(0)
----
0.000

query R
SELECT sqrt(1)
----
1.000

query R
SELECT sqrt(1000000)
----
1000.000

statement error
SELECT sqrt(-1)

query I
SELECT sqrt(NULL)
----
NULL

# Pythagorean.
query R
SELECT sqrt(power(3, 2) + power(4, 2))
----
5.000
