# PG-style CREATE TABLE variations

statement ok
CREATE TABLE a (id INT)

statement ok
CREATE TABLE b (id INT NOT NULL, name TEXT NOT NULL)

statement ok
CREATE TABLE c (id BIGINT NOT NULL, ratio FLOAT, ok BOOL)

# CREATE TABLE with no columns is a parse error.
statement error
CREATE TABLE empty ()

# Duplicate table name is a runtime error.
statement ok
CREATE TABLE dup (id INT)

statement error
CREATE TABLE dup (id INT)
