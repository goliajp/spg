# PG TIMETZ (TIME WITH TIME ZONE) — i64 us local + i32 offset_secs.
# OID 1266. Offset is preserved on output (NOT shifted to UTC),
# matching PG's `timetz_out` behaviour.

statement ok
CREATE TABLE meetings (id INT NOT NULL, started TIMETZ)

statement ok
INSERT INTO meetings VALUES
    (1, '14:30:45+00'),
    (2, '09:00:00+09'),
    (3, '08:30:00-03:30'),
    (4, '14:30:45.123456+05:30'),
    (5, '00:00:00-14'),
    (6, NULL)

# Whole-hour positive offset.
query T
SELECT started FROM meetings WHERE id = 2
----
09:00:00+09

# Sub-hour negative offset (Newfoundland NST = UTC-03:30).
query T
SELECT started FROM meetings WHERE id = 3
----
08:30:00-03:30

# Sub-second + sub-hour positive offset (India IST = UTC+05:30).
query T
SELECT started FROM meetings WHERE id = 4
----
14:30:45.123456+05:30

# UTC literal.
query T
SELECT started FROM meetings WHERE id = 1
----
14:30:45+00

# Boundary offset -14h.
query T
SELECT started FROM meetings WHERE id = 5
----
00:00:00-14

# NULL preserved.
query T
SELECT started FROM meetings WHERE id = 6
----
NULL

# Malformed / missing-offset / out-of-range → hard error.
statement error
INSERT INTO meetings VALUES (99, 'not a time')

statement error
INSERT INTO meetings VALUES (99, '14:30:45')

statement error
INSERT INTO meetings VALUES (99, '14:30:45+15')
