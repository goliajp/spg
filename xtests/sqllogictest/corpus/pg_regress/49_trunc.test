# PG `trunc(x)` / `trunc(x, scale)` — truncate TOWARD zero.
# Distinct from floor (toward -inf) and round (half-away).

query R
SELECT trunc(1.7)
----
1.000

query R
SELECT trunc(-1.7)
----
-1.000

query R
SELECT trunc(-0.5)
----
0.000

query R
SELECT trunc(1.5)
----
1.000

query R
SELECT trunc(2.5)
----
2.000

query R
SELECT trunc(-1.5)
----
-1.000

query R
SELECT trunc(5.0)
----
5.000

query R
SELECT trunc(0.0)
----
0.000

# Two-arg form.
query R
SELECT trunc(1.2345, 2)
----
1.230

query R
SELECT trunc(2.55, 1)
----
2.500

query R
SELECT trunc(-1.99, 1)
----
-1.900

# Negative scale.
query R
SELECT trunc(15, -1)
----
10.000

query R
SELECT trunc(199, -2)
----
100.000

# NULL.
query I
SELECT trunc(NULL)
----
NULL

query I
SELECT trunc(1.5, NULL)
----
NULL

# Integer passthrough.
query I
SELECT trunc(42)
----
42
