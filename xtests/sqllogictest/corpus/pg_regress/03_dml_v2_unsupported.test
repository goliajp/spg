# DML that v1 SPG doesn't implement: UPDATE / DELETE / DROP / ALTER.

statement ok
CREATE TABLE t (id INT NOT NULL, name TEXT)

statement ok
INSERT INTO t VALUES (1, 'x')

statement error
UPDATE t SET name = 'y' WHERE id = 1

statement error
DELETE FROM t WHERE id = 1

statement error
DROP TABLE t

statement error
ALTER TABLE t ADD COLUMN extra INT
