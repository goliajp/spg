# DML coverage history: v4.4 added UPDATE / DELETE; v7.13.0
# unblocked `ALTER TABLE … ADD COLUMN`; v7.14.0 added
# `DROP TABLE [IF EXISTS]` so pg_dump / mysqldump reloads
# work without splitting scripts.

statement ok
CREATE TABLE t (id INT NOT NULL, name TEXT)

statement ok
INSERT INTO t VALUES (1, 'x')

statement ok
INSERT INTO t VALUES (2, 'z')

# v4.4: UPDATE now supported
statement ok
UPDATE t SET name = 'y' WHERE id = 1

query IT rowsort
SELECT id, name FROM t
----
1
y
2
z

# v4.4: DELETE now supported
statement ok
DELETE FROM t WHERE id = 1

query IT rowsort
SELECT id, name FROM t
----
2
z

# v7.13.0 — ALTER TABLE ADD COLUMN is supported (mailrs round-5 G1).
statement ok
ALTER TABLE t ADD COLUMN extra INT

# v7.14.0 — DROP TABLE [IF EXISTS] is supported.
statement ok
DROP TABLE t

statement ok
DROP TABLE IF EXISTS t
