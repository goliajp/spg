# pgvector: ORDER BY v <-> [..] LIMIT N — the kNN probe

statement ok
CREATE TABLE emb (id INT NOT NULL, v VECTOR(3) NOT NULL)

statement ok
INSERT INTO emb VALUES (1, [1.0, 2.0, 3.0])

statement ok
INSERT INTO emb VALUES (2, [4.0, 5.0, 6.0])

statement ok
INSERT INTO emb VALUES (3, [1.0, 2.0, 4.0])

statement ok
INSERT INTO emb VALUES (4, [2.0, 3.0, 4.0])

query I nosort
SELECT id FROM emb ORDER BY v <-> [1.0, 2.0, 3.0] LIMIT 3
----
1
3
4

query I nosort
SELECT id FROM emb ORDER BY v <-> [4.0, 5.0, 6.0] LIMIT 1
----
2

# Full sort, no LIMIT.
query I nosort
SELECT id FROM emb ORDER BY v <-> [0.0, 0.0, 0.0]
----
1
3
4
2

