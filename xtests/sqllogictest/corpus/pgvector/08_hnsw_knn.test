# HNSW (NSW-flavoured) kNN index — `CREATE INDEX ... USING hnsw`.
# The graph search must return the same top-K rows the brute-force
# scan would, just faster.

statement ok
CREATE TABLE docs (id INT NOT NULL, embedding VECTOR(3))

statement ok
INSERT INTO docs VALUES (1, '[0.10, 0.20, 0.30]'::vector)

statement ok
INSERT INTO docs VALUES (2, '[0.90, 0.10, 0.10]'::vector)

statement ok
INSERT INTO docs VALUES (3, '[0.15, 0.25, 0.35]'::vector)

statement ok
INSERT INTO docs VALUES (4, '[0.80, 0.20, 0.10]'::vector)

statement ok
INSERT INTO docs VALUES (5, '[0.50, 0.50, 0.50]'::vector)

# Top-3 kNN BEFORE the HNSW index (brute force).
query I nosort
SELECT id FROM docs ORDER BY embedding <-> '[0.12, 0.22, 0.32]'::vector LIMIT 3
----
1
3
5

statement ok
CREATE INDEX docs_emb_hnsw ON docs USING hnsw (embedding)

# Top-3 kNN AFTER the HNSW index (graph traversal). Same result.
query I nosort
SELECT id FROM docs ORDER BY embedding <-> '[0.12, 0.22, 0.32]'::vector LIMIT 3
----
1
3
5

# An INSERT after the index exists must keep the graph queryable —
# the new point should rank as the nearest neighbour.
statement ok
INSERT INTO docs VALUES (6, '[0.11, 0.21, 0.31]'::vector)

query I nosort
SELECT id FROM docs ORDER BY embedding <-> '[0.12, 0.22, 0.32]'::vector LIMIT 1
----
6
