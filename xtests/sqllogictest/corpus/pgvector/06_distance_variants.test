# pgvector also has `<#>` (inner product) and `<=>` (cosine distance) —
# v1 SPG only ships `<->` (L2). These should fail.

statement ok
CREATE TABLE emb (id INT NOT NULL, v VECTOR(3) NOT NULL)

statement ok
INSERT INTO emb VALUES (1, [1.0, 2.0, 3.0])

statement ok
INSERT INTO emb VALUES (2, [2.0, 3.0, 4.0])

# L2 — already in v1 SPG.
query I nosort
SELECT id FROM emb ORDER BY v <-> [1.0, 2.0, 3.0] LIMIT 1
----
1

# Inner product (pgvector `<#>`). The convention is "negative dot product"
# so smaller (more negative) means more similar. Here [2,3,4]·[1,2,3]=20 >
# [1,2,3]·[1,2,3]=14, so id=2 sorts first.
query I nosort
SELECT id FROM emb ORDER BY v <#> [1.0, 2.0, 3.0] LIMIT 1
----
2

# Cosine distance (pgvector `<=>`). Both [1,2,3] and [2,3,4] have positive
# cosine similarity with the query; id=1 is the exact match (cos=1, cos
# distance=0) and wins.
query I nosort
SELECT id FROM emb ORDER BY v <=> [1.0, 2.0, 3.0] LIMIT 1
----
1

# 7.38.1 S4.2 — cleanup discipline: leave nothing behind.
statement ok
DROP TABLE IF EXISTS emb CASCADE
