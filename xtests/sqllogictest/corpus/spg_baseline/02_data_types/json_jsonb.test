# JSON / JSONB literals + access operators.

statement ok
CREATE TABLE t (id INT NOT NULL, doc JSONB)

statement ok
INSERT INTO t VALUES (1, '{"a": 1, "b": "x"}')

statement ok
INSERT INTO t VALUES (2, '{"a": 2, "b": "y"}')

query I rowsort
SELECT id FROM t WHERE doc->>'b' = 'x'
----
1

query T rowsort
SELECT doc->>'b' FROM t ORDER BY id
----
x
y

# 7.38.1 S4.2 — cleanup discipline: leave nothing behind.
statement ok
DROP TABLE IF EXISTS t CASCADE
