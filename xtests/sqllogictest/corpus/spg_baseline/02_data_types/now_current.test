# NOW() / CURRENT_DATE / CURRENT_TIMESTAMP — deterministic clock pinned
# to 2025-06-15T12:00:00Z by the runner.

query T rowsort
SELECT CURRENT_DATE
----
2025-06-15

# 7.38.1 S4.1 (D5, MATRIX #18 closed) — bare CURRENT_TIMESTAMP again:
# the runner renders timestamptz column-aware now, so embedded text
# carries the PG offset suffix exactly like the wire. One canonical
# answer on every road, cast crutch retired.
query T rowsort
SELECT CURRENT_TIMESTAMP
----
2025-06-15 12:00:00+00
