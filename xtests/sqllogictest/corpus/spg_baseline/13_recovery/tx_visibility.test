# Within-transaction read-your-own-writes visibility.

statement ok
CREATE TABLE t (id INT NOT NULL, v INT NOT NULL)

statement ok
BEGIN

statement ok
INSERT INTO t VALUES (1, 10)

# Same transaction reads the row.
query II rowsort
SELECT id, v FROM t
----
1
10

statement ok
UPDATE t SET v = 99 WHERE id = 1

query II rowsort
SELECT id, v FROM t
----
1
99

statement ok
COMMIT

# 7.38.1 S4.2 — cleanup discipline: leave nothing behind.
statement ok
DROP TABLE IF EXISTS t CASCADE
