# BEGIN / ROLLBACK undoes the writes inside the transaction.

statement ok
CREATE TABLE t (id INT NOT NULL, name TEXT NOT NULL)

statement ok
INSERT INTO t VALUES (1, 'a')

statement ok
BEGIN

statement ok
INSERT INTO t VALUES (2, 'b')

statement ok
ROLLBACK

query IT rowsort
SELECT id, name FROM t
----
1
a

# 7.38.1 S4.2 — cleanup discipline: leave nothing behind.
statement ok
DROP TABLE IF EXISTS t CASCADE
