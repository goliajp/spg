# ON DELETE CASCADE — children removed when parent deletes.

statement ok
CREATE TABLE parent (id INT NOT NULL PRIMARY KEY, name TEXT NOT NULL)

statement ok
CREATE TABLE child (id INT NOT NULL, parent_id INT NOT NULL REFERENCES parent(id) ON DELETE CASCADE)

statement ok
INSERT INTO parent VALUES (1, 'a'), (2, 'b')

statement ok
INSERT INTO child VALUES (10, 1), (11, 1), (12, 2)

statement ok
DELETE FROM parent WHERE id = 1

query I rowsort
SELECT id FROM child ORDER BY id
----
12

# 7.38.1 S4.2 — cleanup discipline: leave nothing behind.
statement ok
DROP TABLE IF EXISTS parent CASCADE

statement ok
DROP TABLE IF EXISTS child CASCADE
