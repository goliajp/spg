# EXISTS / NOT EXISTS.

statement ok
CREATE TABLE a (id INT NOT NULL)

statement ok
CREATE TABLE b (a_id INT NOT NULL)

statement ok
INSERT INTO a VALUES (1), (2), (3)

statement ok
INSERT INTO b VALUES (1), (3)

query I rowsort
SELECT id FROM a WHERE EXISTS (SELECT 1 FROM b WHERE b.a_id = a.id)
----
1
3

query I rowsort
SELECT id FROM a WHERE NOT EXISTS (SELECT 1 FROM b WHERE b.a_id = a.id)
----
2

# 7.38.1 S4.2 — cleanup discipline: leave nothing behind.
statement ok
DROP TABLE IF EXISTS a CASCADE

statement ok
DROP TABLE IF EXISTS b CASCADE
