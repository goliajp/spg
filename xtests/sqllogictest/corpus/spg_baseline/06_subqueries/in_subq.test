# IN (SELECT ...) and NOT IN (SELECT ...).

statement ok
CREATE TABLE t (id INT NOT NULL, name TEXT NOT NULL)

statement ok
CREATE TABLE allow (id INT NOT NULL)

statement ok
INSERT INTO t VALUES (1, 'a'), (2, 'b'), (3, 'c')

statement ok
INSERT INTO allow VALUES (1), (3)

query IT rowsort
SELECT id, name FROM t WHERE id IN (SELECT id FROM allow)
----
1
a
3
c

query IT rowsort
SELECT id, name FROM t WHERE id NOT IN (SELECT id FROM allow)
----
2
b
