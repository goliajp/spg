# v7.37.16 (16.3 / 16.4 / 16.5) — ATTACH / DETACH PARTITION
# round-trip through pgwire.

statement ok
CREATE TABLE p (id BIGINT NOT NULL, region TEXT NOT NULL) PARTITION BY LIST (region)

statement ok
CREATE TABLE c_apac (id BIGINT NOT NULL, region TEXT NOT NULL)

statement ok
ALTER TABLE p ATTACH PARTITION c_apac FOR VALUES IN ('jp', 'kr')

statement ok
INSERT INTO p VALUES (1, 'jp'), (2, 'kr')

query I
SELECT COUNT(*) FROM c_apac
----
2

# Detach demotes the child back to standalone.
statement ok
ALTER TABLE p DETACH PARTITION c_apac

# The rows stay in c_apac; parent UNION shows 0 since it's no
# longer a partition.
query I
SELECT COUNT(*) FROM c_apac
----
2

query I
SELECT COUNT(*) FROM p
----
0

# v7.39 (round 621) — re-attaching a NON-EMPTY child scans its rows (16.3.b)
# instead of demanding emptiness. Both rows carry 'jp'/'kr', which the bound
# takes, so the attach succeeds where the old gate refused it — this case
# asserted the gate until the scan landed.
statement ok
ALTER TABLE p ATTACH PARTITION c_apac FOR VALUES IN ('jp', 'kr')

query I
SELECT COUNT(*) FROM p
----
2

# And a row the bound does NOT take blocks the attach, before any role is
# installed.
statement ok
ALTER TABLE p DETACH PARTITION c_apac

statement ok
INSERT INTO c_apac VALUES (3, 'us')

statement error
ALTER TABLE p ATTACH PARTITION c_apac FOR VALUES IN ('jp', 'kr')

statement ok
DELETE FROM c_apac WHERE region = 'us'

statement ok
ALTER TABLE p ATTACH PARTITION c_apac FOR VALUES IN ('jp', 'kr')

# CONCURRENTLY + FINALIZE accepted at the parser (single-engine
# = atomic detach internally; PG's two-phase split exists for
# replication lag, which doesn't apply here).
statement ok
ALTER TABLE p DETACH PARTITION c_apac CONCURRENTLY FINALIZE

# 7.38.1 S4.2 — cleanup discipline: leave nothing behind.
statement ok
DROP TABLE IF EXISTS p CASCADE

statement ok
DROP TABLE IF EXISTS c_apac CASCADE
