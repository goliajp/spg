# SET TRANSACTION ISOLATION LEVEL — measured against PostgreSQL 18.6.
#
# v7.39: this file used to assert that a BARE `SET TRANSACTION
# ISOLATION LEVEL x` — outside any transaction block — changed the
# session's level, and that `SHOW transaction_isolation` then answered
# `x`. That is not what PG does, and the file had been defending the
# difference rather than catching it. Measured:
#
#     SET TRANSACTION ISOLATION LEVEL SERIALIZABLE;
#     WARNING:  SET TRANSACTION can only be used in transaction blocks
#     SHOW transaction_isolation;  ->  read committed
#
# PG warns and does nothing. SPG applied it to the session, so one bare
# `SET TRANSACTION` quietly changed every LATER transaction — the
# opposite of PG, where it changes none.
#
# The old header also said "every level reads as effective READ
# COMMITTED". That stopped being true in v7.37.15, which caches the
# BEGIN snapshot for REPEATABLE READ / SERIALIZABLE. The behavioural
# side is pinned by xtests/isolation/08, 09 and 10, whose expectations
# were generated by running the specs against PG 18.6.

# Default before any SET.
query T nosort
SHOW transaction_isolation
----
read committed

# Outside a transaction block: accepted, warns, and has NO effect.
# PG keeps `read committed` after every one of these.
statement ok
SET TRANSACTION ISOLATION LEVEL READ COMMITTED

query T nosort
SHOW transaction_isolation
----
read committed

statement ok
SET TRANSACTION ISOLATION LEVEL READ UNCOMMITTED

query T nosort
SHOW transaction_isolation
----
read committed

statement ok
SET TRANSACTION ISOLATION LEVEL REPEATABLE READ

query T nosort
SHOW transaction_isolation
----
read committed

statement ok
SET TRANSACTION ISOLATION LEVEL SERIALIZABLE

query T nosort
SHOW transaction_isolation
----
read committed

# Inside a block it takes effect, and PG KEEPS the label it was given —
# `read uncommitted` is reported as asked for, not folded to the level
# it behaves as.
statement ok
BEGIN

statement ok
SET TRANSACTION ISOLATION LEVEL READ UNCOMMITTED

query T nosort
SHOW transaction_isolation
----
read uncommitted

statement ok
COMMIT

# The block's level ends with the block.
query T nosort
SHOW transaction_isolation
----
read committed

statement ok
BEGIN

statement ok
SET TRANSACTION ISOLATION LEVEL REPEATABLE READ

query T nosort
SHOW transaction_isolation
----
repeatable read

statement ok
COMMIT

statement ok
BEGIN

statement ok
SET TRANSACTION ISOLATION LEVEL SERIALIZABLE

query T nosort
SHOW transaction_isolation
----
serializable

statement ok
COMMIT

query T nosort
SHOW transaction_isolation
----
read committed

# PG refuses the switch once the block has run a query (SQLSTATE 25001):
# a transaction that is half one level and half another is not a level.
statement ok
BEGIN

statement ok
SELECT 1

statement error
SET TRANSACTION ISOLATION LEVEL SERIALIZABLE

statement ok
ROLLBACK

# The session default is a SETTING, not a constant: `default_transaction_isolation`
# governs what a block with no level of its own gets, and what the session
# returns to afterwards. Measured on PG 18.6.
statement ok
SET default_transaction_isolation = 'repeatable read'

query T nosort
SHOW transaction_isolation
----
repeatable read

statement ok
BEGIN

query T nosort
SHOW transaction_isolation
----
repeatable read

statement ok
COMMIT

query T nosort
SHOW transaction_isolation
----
repeatable read

statement ok
SET default_transaction_isolation = 'read committed'

query T nosort
SHOW transaction_isolation
----
read committed
