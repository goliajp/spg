# RETURNING on INSERT / UPDATE / DELETE.

statement ok
CREATE TABLE t (id INT NOT NULL, name TEXT NOT NULL)

query IT rowsort
INSERT INTO t VALUES (1, 'a') RETURNING id, name
----
1
a

query I rowsort
INSERT INTO t VALUES (2, 'b'), (3, 'c') RETURNING id
----
2
3

query IT rowsort
UPDATE t SET name = 'X' WHERE id = 2 RETURNING id, name
----
2
X

query IT rowsort
DELETE FROM t WHERE id = 3 RETURNING id, name
----
3
c

query IT rowsort
SELECT id, name FROM t ORDER BY id
----
1
a
2
X

# 7.38.1 S4.2 — cleanup discipline: leave nothing behind.
statement ok
DROP TABLE IF EXISTS t CASCADE
