# WHERE: comparison ops, AND/OR/NOT, IN, BETWEEN, IS NULL.

statement ok
CREATE TABLE t (id INT NOT NULL, name TEXT NOT NULL, score INT)

statement ok
INSERT INTO t VALUES (1, 'a', 50)

statement ok
INSERT INTO t VALUES (2, 'b', 70)

statement ok
INSERT INTO t VALUES (3, 'c', 90)

statement ok
INSERT INTO t VALUES (4, 'd', NULL)

query I rowsort
SELECT id FROM t WHERE score = 70
----
2

query I rowsort
SELECT id FROM t WHERE score > 60
----
2
3

query I rowsort
SELECT id FROM t WHERE score >= 70
----
2
3

query I rowsort
SELECT id FROM t WHERE score < 90
----
1
2

query I rowsort
SELECT id FROM t WHERE score <> 70
----
1
3

query I rowsort
SELECT id FROM t WHERE score >= 70 AND id < 4
----
2
3

query I rowsort
SELECT id FROM t WHERE score < 60 OR score > 80
----
1
3

query I rowsort
SELECT id FROM t WHERE NOT (score >= 70)
----
1

query I rowsort
SELECT id FROM t WHERE score IS NULL
----
4

query I rowsort
SELECT id FROM t WHERE score IS NOT NULL
----
1
2
3

query I rowsort
SELECT id FROM t WHERE id IN (1, 3)
----
1
3

query I rowsort
SELECT id FROM t WHERE id NOT IN (1, 3)
----
2
4

query I rowsort
SELECT id FROM t WHERE score BETWEEN 60 AND 80
----
2

query I rowsort
SELECT id FROM t WHERE name = 'b'
----
2

