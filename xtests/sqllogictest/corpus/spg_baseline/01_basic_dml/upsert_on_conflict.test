# INSERT ... ON CONFLICT DO UPDATE / DO NOTHING.

statement ok
CREATE TABLE t (id INT NOT NULL PRIMARY KEY, name TEXT NOT NULL, hits INT NOT NULL)

statement ok
INSERT INTO t VALUES (1, 'a', 1)

statement ok
INSERT INTO t VALUES (1, 'a', 99) ON CONFLICT (id) DO NOTHING

# DO NOTHING: row 1 unchanged.
query II rowsort
SELECT id, hits FROM t
----
1
1

statement ok
INSERT INTO t VALUES (1, 'a', 5) ON CONFLICT (id) DO UPDATE SET hits = t.hits + EXCLUDED.hits

query II rowsort
SELECT id, hits FROM t
----
1
6

statement ok
INSERT INTO t VALUES (2, 'b', 2) ON CONFLICT (id) DO UPDATE SET hits = EXCLUDED.hits

query II rowsort
SELECT id, hits FROM t ORDER BY id
----
1
6
2
2

# 7.38.1 S4.2 — cleanup discipline: leave nothing behind.
statement ok
DROP TABLE IF EXISTS t CASCADE
