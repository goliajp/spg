# ORDER BY ASC/DESC NULLS, LIMIT, OFFSET.

statement ok
CREATE TABLE t (id INT NOT NULL, score INT)

statement ok
INSERT INTO t VALUES (1, 30)

statement ok
INSERT INTO t VALUES (2, 10)

statement ok
INSERT INTO t VALUES (3, NULL)

statement ok
INSERT INTO t VALUES (4, 20)

query I nosort
SELECT id FROM t ORDER BY id
----
1
2
3
4

query I nosort
SELECT id FROM t ORDER BY id DESC
----
4
3
2
1

query I nosort
SELECT id FROM t ORDER BY score ASC NULLS FIRST
----
3
2
4
1

query I nosort
SELECT id FROM t ORDER BY score ASC NULLS LAST
----
2
4
1
3

query I nosort
SELECT id FROM t ORDER BY score DESC NULLS LAST
----
1
4
2
3

query I nosort
SELECT id FROM t ORDER BY id LIMIT 2
----
1
2

query I nosort
SELECT id FROM t ORDER BY id LIMIT 2 OFFSET 1
----
2
3

query I nosort
SELECT id FROM t ORDER BY id OFFSET 2
----
3
4

