# Aggregate over whole table (no GROUP BY).

statement ok
CREATE TABLE t (v INT NOT NULL)

statement ok
INSERT INTO t VALUES (1), (2), (3), (4)

query I rowsort
SELECT COUNT(*) FROM t
----
4

query I rowsort
SELECT SUM(v) FROM t
----
10

query R rowsort
SELECT AVG(v) FROM t
----
2.5000000000000000

# 7.38.1 S4.2 — cleanup discipline: leave nothing behind.
statement ok
DROP TABLE IF EXISTS t CASCADE
