statement ok
CREATE TABLE t (id INT NOT NULL, g TEXT NOT NULL, v INT NOT NULL)

statement ok
INSERT INTO t VALUES (1, 'x', 30), (2, 'x', 10), (3, 'x', 20), (4, 'y', 100), (5, 'y', 50)

query ITI nosort
SELECT id, g, ROW_NUMBER() OVER (PARTITION BY g ORDER BY v) FROM t ORDER BY g, v
