# 7.38.2 S-2 (sentori report 5) — the PG upsert idiom
# `RETURNING (xmax = 0) AS is_new`. PG18 anchors (differential
# 2026-08-19): plain INSERT xmax=0; conflict-updated row nonzero;
# UPDATE's new tuple 0; DELETE's old tuple nonzero.

statement ok
CREATE TABLE rxm_up (id INT PRIMARY KEY, v TEXT)

query TT
INSERT INTO rxm_up VALUES (1, 'a') ON CONFLICT (id) DO UPDATE SET v = excluded.v RETURNING id, (xmax = 0) AS is_new
----
1
t

query TT
INSERT INTO rxm_up VALUES (1, 'b') ON CONFLICT (id) DO UPDATE SET v = excluded.v RETURNING id, (xmax = 0) AS is_new
----
1
f

query T
INSERT INTO rxm_up VALUES (2, 'c') RETURNING xmax
----
0

query T
UPDATE rxm_up SET v = 'd' WHERE id = 2 RETURNING xmax
----
0

query T
DELETE FROM rxm_up WHERE id = 2 RETURNING (xmax = 0)
----
f

statement ok
DROP TABLE rxm_up
