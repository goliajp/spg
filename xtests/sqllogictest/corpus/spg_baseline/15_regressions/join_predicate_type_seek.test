# A JOIN's answer must not depend on the PREDICATE column's type (r1037).
#
# `WHERE s.k = '<uuid literal>'` inside a join took an index seek that
# built its key straight from the literal, so a string literal was always
# TEXT. On a `uuid` / `date` / `timestamp` column the seek looked in a key
# space nothing lives in, found nothing, and the whole query answered zero
# rows — no error, no warning.
#
# Round 564 made this exact decision correctly on the single-table seek
# and wrote down why it matters: creating an index changed the answer,
# which is the one thing an index may never do. The join driver's seek was
# a second copy that never got the fix, and the peer's was a third.
#
# The controls that make this a diagnosis rather than a guess are in the
# file: the same predicate without a join, with an explicit cast, and in
# the ON clause were all correct throughout.

statement ok
CREATE TABLE jpu (id INT PRIMARY KEY, role TEXT)

statement ok
CREATE TABLE jps (k UUID PRIMARY KEY, uid INT NOT NULL, note TEXT)

statement ok
INSERT INTO jpu VALUES (1, 'admin')

statement ok
INSERT INTO jps VALUES ('11111111-1111-4111-8111-111111111111', 1, 'n')

# The reported shape.
query I
SELECT count(*) FROM jps s JOIN jpu u ON u.id = s.uid WHERE s.k = '11111111-1111-4111-8111-111111111111'
----
1

# The three spellings that were already correct, kept as controls: without
# the join, with an explicit cast, and with the predicate in the ON clause.
query I
SELECT count(*) FROM jps s WHERE s.k = '11111111-1111-4111-8111-111111111111'
----
1

query I
SELECT count(*) FROM jps s JOIN jpu u ON u.id = s.uid WHERE s.k = '11111111-1111-4111-8111-111111111111'::uuid
----
1

query I
SELECT count(*) FROM jps s JOIN jpu u ON u.id = s.uid AND s.k = '11111111-1111-4111-8111-111111111111'
----
1

# An IN list takes the same seek.
query I
SELECT count(*) FROM jps s JOIN jpu u ON u.id = s.uid WHERE s.k IN ('11111111-1111-4111-8111-111111111111')
----
1

# The row itself, not just its count.
query T
SELECT u.role FROM jps s JOIN jpu u ON u.id = s.uid WHERE s.k = '11111111-1111-4111-8111-111111111111'
----
admin

# A key that does not exist must still find nothing — the fix must not
# make the seek over-match.
query I
SELECT count(*) FROM jps s JOIN jpu u ON u.id = s.uid WHERE s.k = '99999999-9999-4999-8999-999999999999'
----
0

# --- date and timestamp took the same seek ---

statement ok
CREATE TABLE jpd (k DATE PRIMARY KEY, uid INT NOT NULL)

statement ok
INSERT INTO jpd VALUES (DATE '2026-01-02', 1)

query I
SELECT count(*) FROM jpd s JOIN jpu u ON u.id = s.uid WHERE s.k = '2026-01-02'
----
1

query I
SELECT count(*) FROM jpd s JOIN jpu u ON u.id = s.uid WHERE s.k = '2026-01-03'
----
0

statement ok
CREATE TABLE jpt (k TIMESTAMP PRIMARY KEY, uid INT NOT NULL)

statement ok
INSERT INTO jpt VALUES (TIMESTAMP '2026-01-02 03:04:05', 1)

query I
SELECT count(*) FROM jpt s JOIN jpu u ON u.id = s.uid WHERE s.k = '2026-01-02 03:04:05'
----
1

# --- a bytea primary key with a bound parameter: sentori's second report ---

statement ok
CREATE TABLE jpb (id_hash BYTEA PRIMARY KEY, uid INT NOT NULL)

statement ok
INSERT INTO jpb VALUES (decode('deadbeef','hex'), 1)

query I
SELECT count(*) FROM jpb s JOIN jpu u ON u.id = s.uid WHERE s.id_hash = decode('deadbeef','hex')
----
1

statement ok
PREPARE jpb_bound(BYTEA) AS SELECT count(*) FROM jpb s JOIN jpu u ON u.id = s.uid WHERE s.id_hash = $1

query I
EXECUTE jpb_bound(decode('deadbeef','hex'))
----
1

statement ok
DEALLOCATE jpb_bound

statement ok
DROP TABLE jpb

statement ok
DROP TABLE jpt

statement ok
DROP TABLE jpd

statement ok
DROP TABLE jps

statement ok
DROP TABLE jpu
