# information_schema queries — drop-in compat (mailrs uses these).

statement ok
CREATE TABLE t (id INT NOT NULL, name TEXT NOT NULL)

# Just verify the catalog query parses & returns a row count.
query I rowsort
SELECT COUNT(*) FROM information_schema.tables WHERE table_name = 't'
----
1

# 7.38.1 S4.2 — cleanup discipline: leave nothing behind.
statement ok
DROP TABLE IF EXISTS t CASCADE
