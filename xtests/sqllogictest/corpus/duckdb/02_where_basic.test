# Basic WHERE predicates

statement ok
CREATE TABLE t (id INT NOT NULL, name TEXT NOT NULL, score INT)

statement ok
INSERT INTO t VALUES (1, 'alice', 90)

statement ok
INSERT INTO t VALUES (2, 'bob', NULL)

statement ok
INSERT INTO t VALUES (3, 'cara', 70)

query IT nosort
SELECT id, name FROM t WHERE id = 1
----
1
alice

query I nosort
SELECT id FROM t WHERE id > 1
----
2
3

# NULL handling: `> 80` against NULL is NULL → filtered out.
query I nosort
SELECT id FROM t WHERE score > 80
----
1

# 7.38.1 S4.2 — cleanup discipline: leave nothing behind.
statement ok
DROP TABLE IF EXISTS t CASCADE
