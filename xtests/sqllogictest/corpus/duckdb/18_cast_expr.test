# `expr::type` cast — PG syntax, also accepted by DuckDB.

statement ok
CREATE TABLE t (a INT NOT NULL)

statement ok
INSERT INTO t VALUES (42)

query T nosort
SELECT a::TEXT FROM t
----
42

query R nosort
SELECT a::FLOAT FROM t
----
42

query I nosort
SELECT '7'::INT
----
7

# 7.38.1 S4.2 — cleanup discipline: leave nothing behind.
statement ok
DROP TABLE IF EXISTS t CASCADE
