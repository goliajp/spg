# Transaction shapes

statement ok
CREATE TABLE t (v INT NOT NULL)

statement ok
BEGIN

statement ok
INSERT INTO t VALUES (1)

statement ok
INSERT INTO t VALUES (2)

statement ok
COMMIT

query I nosort
SELECT v FROM t ORDER BY v
----
1
2

statement ok
BEGIN

statement ok
INSERT INTO t VALUES (99)

statement ok
ROLLBACK

query I nosort
SELECT v FROM t ORDER BY v
----
1
2

# Double BEGIN errors.
statement ok
BEGIN

statement error
BEGIN

statement ok
ROLLBACK

# COMMIT without an active TX.
#
# v7.39 (round 435) — DuckDB errors here ("cannot commit - no transaction is
# active"), and SPG used to as well. Both of SPG's drop-in targets disagree,
# measured live: PG18 replies `WARNING: there is no transaction in progress`
# and still reports COMMIT; MariaDB 11 succeeds silently. A PG/MySQL drop-in
# has to answer the way PG and MySQL answer, so this is a deliberate,
# recorded deviation from the DuckDB corpus rather than a silent one.
statement ok
COMMIT
