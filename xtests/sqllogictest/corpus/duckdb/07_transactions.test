# Transaction shapes

statement ok
CREATE TABLE t (v INT NOT NULL)

statement ok
BEGIN

statement ok
INSERT INTO t VALUES (1)

statement ok
INSERT INTO t VALUES (2)

statement ok
COMMIT

query I nosort
SELECT v FROM t ORDER BY v
----
1
2

statement ok
BEGIN

statement ok
INSERT INTO t VALUES (99)

statement ok
ROLLBACK

query I nosort
SELECT v FROM t ORDER BY v
----
1
2

# Double BEGIN errors.
statement ok
BEGIN

statement error
BEGIN

statement ok
ROLLBACK

# COMMIT without active TX errors.
statement error
COMMIT
