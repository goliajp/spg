# Multi-VALUES INSERT — `INSERT INTO t VALUES (a), (b), (c)`.

statement ok
CREATE TABLE t (a INT NOT NULL)

# PG / DuckDB shape. SPG v1.3+ accepts this.
statement ok
INSERT INTO t VALUES (1), (2), (3)

query I nosort
SELECT a FROM t ORDER BY a
----
1
2
3

# Single-row form still fine.
statement ok
INSERT INTO t VALUES (4)
