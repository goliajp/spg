# Aggregates: COUNT / SUM / AVG / MIN / MAX, and GROUP BY.

statement ok
CREATE TABLE sales (region TEXT NOT NULL, amount INT NOT NULL)

statement ok
INSERT INTO sales VALUES ('north', 10)

statement ok
INSERT INTO sales VALUES ('north', 20)

statement ok
INSERT INTO sales VALUES ('south', 30)

statement ok
INSERT INTO sales VALUES ('south', 40)

query I nosort
SELECT COUNT(*) FROM sales
