# Precedence: 1 + 2 * 3 = 7
query I nosort
SELECT a FROM n WHERE 1 + 2 * 3 = 7
----
1
2
3

query I nosort
SELECT a FROM n WHERE a + 1 = 3
----
2

query I nosort
SELECT a FROM n WHERE b / 10 > 1
----
2
3

