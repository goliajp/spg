# `IS NULL` / `IS NOT NULL` postfix predicates — SPG v1.3+.

statement ok
CREATE TABLE u (id INT NOT NULL, name TEXT)

statement ok
INSERT INTO u VALUES (1, 'alice')

statement ok
INSERT INTO u VALUES (2, NULL)

statement ok
INSERT INTO u VALUES (3, 'cara')

query I rowsort
SELECT id FROM u WHERE name IS NULL
----
2

query I rowsort
SELECT id FROM u WHERE name IS NOT NULL
----
1
3

# 7.38.1 S4.2 — cleanup discipline: leave nothing behind.
statement ok
DROP TABLE IF EXISTS u CASCADE
