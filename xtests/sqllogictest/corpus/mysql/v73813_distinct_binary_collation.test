# v7.38.13 — DISTINCT honours an explicit binary collation.
#
# A column declared `COLLATE utf8mb4_bin` compares BYTE-WISE, so 'a' and
# 'A' are two values, not one. GROUP BY got this right; DISTINCT folded
# them anyway and answered one row where MariaDB 11 answers two — the
# silent-wrong-answer shape the round-370 tests were written against,
# in the one spelling they did not cover.
#
# Root cause: the DISTINCT comparator took a bare `mysql: bool` and so
# could never see a column, and the projection dropped the declared
# collation on its way to the output schema — the fourth field to be
# lost through that same hole, after enum identity, fsp and the PG
# collation name.
#
# Every expectation below is from a MariaDB 11 run.

# Declare the session's dialect the way a mysqldump would, as the
# neighbouring fixtures do.
dialect mysql

statement ok
SET sql_mode = 'STRICT_TRANS_TABLES'

statement ok
CREATE TABLE bin_t (t VARCHAR(10) COLLATE utf8mb4_bin)

statement ok
INSERT INTO bin_t VALUES ('a'),('A'),('bar'),('Bar')

# Four distinct values, because the column is byte-wise.
query I
SELECT COUNT(*) FROM (SELECT DISTINCT t FROM bin_t) g
----
4

# The GROUP BY spelling of the same question agrees.
query I
SELECT COUNT(*) FROM (SELECT t FROM bin_t GROUP BY t) g
----
4

# The values themselves, so a wrong survivor is visible and not just a
# wrong count. Ordered by LENGTH then by the count of each, which needs
# no claim about how a binary collation sorts.
#
# The order this file used to leave unpinned is pinned below, from a
# MySQL 9.7.1 run.
query II
SELECT LENGTH(t), COUNT(*) FROM (SELECT DISTINCT t FROM bin_t) g GROUP BY 1 ORDER BY 1
----
1
2
3
2

# NEGATIVE CONTROL — a column with NO explicit collation still folds
# under the MySQL default. A fix that exempted every column would turn
# this from 2 into 4.
statement ok
CREATE TABLE ci_t (t VARCHAR(10))

statement ok
INSERT INTO ci_t VALUES ('a'),('A'),('bar'),('Bar')

query I
SELECT COUNT(*) FROM (SELECT DISTINCT t FROM ci_t) g
----
2

# v7.38.13 — ORDER BY on the byte-wise column, the sibling this file
# recorded and could not pin. Every expectation below is from a MySQL
# 9.7.1 run (`docker exec spg-bench-mysql mysql`), not hand-computed:
# the first draft of this file DID hand-compute this shape and the
# runner disagreed.
#
# SPG answered `a, A, bar, Bar` -- the DEFAULT collation's answer -- for
# all three of the column's declaration, an explicit `COLLATE "C"`, and
# an explicit `COLLATE utf8mb4_bin`. Two causes stacked: `collate::compare`
# had no case for MySQL's byte-order names and returned "cannot perform",
# and the ORDER BY key was folded at BUILD time, where no comparator
# downstream can un-fold it.
#
# No ties are possible here: byte-wise, all four values differ, so the
# whole sequence is determined and a wrong survivor cannot hide behind an
# unspecified tie order.
query T
SELECT t FROM bin_t ORDER BY t
----
A
Bar
a
bar

query T
SELECT t FROM bin_t ORDER BY t DESC
----
bar
a
Bar
A

# The DISTINCT and GROUP BY spellings order the same way.
query T
SELECT DISTINCT t FROM bin_t ORDER BY t
----
A
Bar
a
bar

query T
SELECT t FROM bin_t GROUP BY t ORDER BY t
----
A
Bar
a
bar

# MIN/MAX read the same collation. MySQL 9.7.1 answers A / bar; SPG
# answered a / bar, so MIN was wrong and MAX agreed by accident.
query TT
SELECT MIN(t), MAX(t) FROM bin_t
----
A
bar

# Top-N takes a different route to the answer: the trim discards rows
# BEFORE the collation-aware sort runs, comparing with the sort
# directions and no collation at all. If it dropped the wrong row the
# limited answer would stop being a prefix of the unlimited one. These
# expectations are that prefix, from the same MySQL 9.7.1 order above --
# no tie is involved, so there is nothing to hand-compute.
query T
SELECT t FROM bin_t ORDER BY t LIMIT 2
----
A
Bar

query T
SELECT t FROM bin_t ORDER BY t DESC LIMIT 2
----
bar
a

# NEGATIVE CONTROL for the ORDER BY fix, on values that admit NO tie.
# 'B' is 0x42 and 'a' is 0x61, so byte order gives B, a while the MySQL
# default folds to a, B. A fix that exempted every column -- or that
# stopped folding unconditionally -- turns this pair around.
statement ok
CREATE TABLE ord_ci (t VARCHAR(10))

statement ok
INSERT INTO ord_ci VALUES ('B'),('a')

query T
SELECT t FROM ord_ci ORDER BY t
----
a
B

# The same two values on a byte-wise column go the other way.
statement ok
CREATE TABLE ord_bin (t VARCHAR(10) COLLATE utf8mb4_bin)

statement ok
INSERT INTO ord_bin VALUES ('B'),('a')

query T
SELECT t FROM ord_bin ORDER BY t
----
B
a

statement ok
DROP TABLE ord_ci

statement ok
DROP TABLE ord_bin

# Trailing spaces still PAD-SPACE-fold on the default column, and still
# do not on the byte-wise one.
statement ok
INSERT INTO ci_t VALUES ('a ')

query I
SELECT COUNT(*) FROM (SELECT DISTINCT t FROM ci_t) g
----
2

statement ok
INSERT INTO bin_t VALUES ('a ')

query I
SELECT COUNT(*) FROM (SELECT DISTINCT t FROM bin_t) g
----
5

statement ok
DROP TABLE bin_t

statement ok
DROP TABLE ci_t
