# v7.38.14 — a join's ON predicate must reach the same answer whichever
# shape it takes. Every expectation below is from a MySQL 9.7.1 run.
#
# MySQL, for `l(1,'a'),(2,'b')` joined against `r(1,'A'),(2,'b')`:
#
#   collation      ON l.s = r.s      ON (l.s = r.s OR FALSE)
#   default (CI)        2                      2
#   utf8mb4_bin         1                      1
#
# The predicate SHAPE must not change the answer. SPG's did: the two
# spellings take different join strategies, and only one of them was
# honouring the column's collation.

dialect mysql

statement ok
SET sql_mode = 'STRICT_TRANS_TABLES'

statement ok
CREATE TABLE jl (id INT, s VARCHAR(20))

statement ok
CREATE TABLE jr (id INT, s VARCHAR(20))

statement ok
INSERT INTO jl VALUES (1,'a'),(2,'b')

statement ok
INSERT INTO jr VALUES (1,'A'),(2,'b')

# The expression-evaluated join path. `OR FALSE` is not decoration: it
# stops an equi-key being extracted, which is what routes the query to
# the path this release fixed. Without carrying the column's collation
# into the join's combined schema, every column there reads as an
# explicit binary column and this answers 1.
query I
SELECT COUNT(*) FROM jl JOIN jr ON (jl.s = jr.s OR FALSE)
----
2

# NEGATIVE CONTROL — a byte-wise column must NOT fold on the same path.
# A fix that simply stopped consulting the collation would turn this
# into 2.
statement ok
CREATE TABLE bl (id INT, s VARCHAR(20) COLLATE utf8mb4_bin)

statement ok
CREATE TABLE br (id INT, s VARCHAR(20) COLLATE utf8mb4_bin)

statement ok
INSERT INTO bl VALUES (1,'a'),(2,'b')

statement ok
INSERT INTO br VALUES (1,'A'),(2,'b')

query I
SELECT COUNT(*) FROM bl JOIN br ON (bl.s = br.s OR FALSE)
----
1

query I
SELECT COUNT(*) FROM bl JOIN br ON bl.s = br.s
----
1

# The equi-key spelling, which reaches the answer a completely different
# way: `extract_join_keys` (join.rs:708) lifts the conjunct out of the ON
# and turns it into a HASH KEY, so the fold has to happen in the key
# ENCODING or it does not happen at all -- byte-equal and fold-equal put
# 'a' and 'A' in different buckets and the rows never meet. That is why
# three separate fixes to the expression comparator changed nothing here.
#
# Both halves of the hash read one mask resolved once per join. A mask
# consulted on the build side only would stop the join matching at all,
# which is the trap 3b494b6e names for DISTINCT's hash and comparator.
query I
SELECT COUNT(*) FROM jl JOIN jr ON jl.s = jr.s
----
2

# NEGATIVE CONTROL — the same spelling on byte-wise columns must NOT
# fold. A fix that folded whenever the dialect is MySQL turns this into 2.
query I
SELECT COUNT(*) FROM bl JOIN br ON bl.s = br.s
----
1

# Two more spellings of the same equality, both from the same MySQL
# 9.7.1 run. ANSI-89 is not a variation for its own sake: its equi key is
# lifted out of the WHERE at a DIFFERENT site from the ON conjuncts, and
# that site used to push the key without the fold flag beside it -- so
# this spelling answered 0 while `JOIN ... ON` answered correctly.
query I
SELECT COUNT(*) FROM jl, jr WHERE jl.s = jr.s
----
2

query I
SELECT COUNT(*) FROM jl WHERE EXISTS (SELECT 1 FROM jr WHERE jr.s = jl.s)
----
2

# NEGATIVE CONTROLS — byte-wise columns, same two spellings.
query I
SELECT COUNT(*) FROM bl, br WHERE bl.s = br.s
----
1

query I
SELECT COUNT(*) FROM bl WHERE EXISTS (SELECT 1 FROM br WHERE br.s = bl.s)
----
1

# The predicate SHAPE now makes no difference on either collation, which
# is the property MySQL has and the one that was missing.

statement ok
DROP TABLE jl

statement ok
DROP TABLE jr

statement ok
DROP TABLE bl

statement ok
DROP TABLE br
