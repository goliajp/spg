# v7.38.14 — a join's ON predicate must reach the same answer whichever
# shape it takes. Every expectation below is from a MySQL 9.7.1 run.
#
# MySQL, for `l(1,'a'),(2,'b')` joined against `r(1,'A'),(2,'b')`:
#
#   collation      ON l.s = r.s      ON (l.s = r.s OR FALSE)
#   default (CI)        2                      2
#   utf8mb4_bin         1                      1
#
# The predicate SHAPE must not change the answer. SPG's did: the two
# spellings take different join strategies, and only one of them was
# honouring the column's collation.

statement ok
SET sql_mode = 'STRICT_TRANS_TABLES'

statement ok
CREATE TABLE jl (id INT, s VARCHAR(20))

statement ok
CREATE TABLE jr (id INT, s VARCHAR(20))

statement ok
INSERT INTO jl VALUES (1,'a'),(2,'b')

statement ok
INSERT INTO jr VALUES (1,'A'),(2,'b')

# The expression-evaluated join path. `OR FALSE` is not decoration: it
# stops an equi-key being extracted, which is what routes the query to
# the path this release fixed. Without carrying the column's collation
# into the join's combined schema, every column there reads as an
# explicit binary column and this answers 1.
query I
SELECT COUNT(*) FROM jl JOIN jr ON (jl.s = jr.s OR FALSE)
----
2

# NEGATIVE CONTROL — a byte-wise column must NOT fold on the same path.
# A fix that simply stopped consulting the collation would turn this
# into 2.
statement ok
CREATE TABLE bl (id INT, s VARCHAR(20) COLLATE utf8mb4_bin)

statement ok
CREATE TABLE br (id INT, s VARCHAR(20) COLLATE utf8mb4_bin)

statement ok
INSERT INTO bl VALUES (1,'a'),(2,'b')

statement ok
INSERT INTO br VALUES (1,'A'),(2,'b')

query I
SELECT COUNT(*) FROM bl JOIN br ON (bl.s = br.s OR FALSE)
----
1

query I
SELECT COUNT(*) FROM bl JOIN br ON bl.s = br.s
----
1

# RECORDED, NOT PINNED — the equi-key path is still byte-wise.
# `SELECT COUNT(*) FROM jl JOIN jr ON jl.s = jr.s` answers 1 here and 2
# on MySQL 9.7.1. It is deliberately absent rather than written with the
# wrong number: pinning 1 would freeze the defect into the corpus.
#
# Root cause, verified by ablation rather than read: an equi conjunct is
# lifted out of the ON by `extract_join_keys` (join.rs:708) and becomes a
# HASH KEY, encoded by `aggregate::encode_key_refs_into`, which resolves
# to `encode_key_refs_into_in(.., false)` (aggregate.rs:7505) — byte-wise
# whatever the column declares. The expression comparator is never
# consulted, which is why three separate fixes to it changed nothing.
#
# The fix needs a per-position fold mask built once per join from the key
# columns' collations and applied to BOTH the build and the probe side —
# a hash that folds on one side only would stop matching entirely, which
# is the same trap 3b494b6e names for DISTINCT.

statement ok
DROP TABLE jl

statement ok
DROP TABLE jr

statement ok
DROP TABLE bl

statement ok
DROP TABLE br
