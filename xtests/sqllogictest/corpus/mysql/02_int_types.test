# MySQL-flavoured integer / numeric type aliases (v2.8). Each maps to
# the closest SPG type.
#
# v7.39 (round 471) — the header used to say "UNSIGNED is parsed and
# dropped (no semantic effect — SPG holds the value in the signed twin)".
# It no longer is: BIGINT UNSIGNED carries its full 0..2^64-1 range, and
# SHOW COLUMNS reports the DECLARED type in a MySQL session rather than
# the storage tag. The expectations below are a live MariaDB 11 run.

# v7.39 (round 274) — declare the session's dialect the way a mysqldump
# preamble does. PG's REAL is 4-byte and MySQL's REAL is a synonym for
# DOUBLE, so this file's expectations only hold in a MySQL session.
statement ok
SET sql_mode = 'STRICT_TRANS_TABLES'

statement ok
CREATE TABLE mixed (
  tiny_v TINYINT NOT NULL,
  mid_v MEDIUMINT NOT NULL,
  int_v INTEGER NOT NULL,
  big_v BIGINT UNSIGNED NOT NULL,
  d_v DOUBLE,
  r_v REAL,
  flag BOOLEAN
)

# SHOW COLUMNS surfaces the storage type after the alias rewrite.
query TTI nosort
SHOW COLUMNS FROM mixed
----
tiny_v
tinyint(4)
0
mid_v
mediumint(9)
0
int_v
int(11)
0
big_v
bigint(20) unsigned
0
d_v
double
1
r_v
double
1
flag
tinyint(1)
1

statement ok
INSERT INTO mixed VALUES (12, 1000, 100000, 9999999999, 3.14, 2.71, TRUE)

query I nosort
SELECT tiny_v + mid_v FROM mixed
----
1012

# TINYINT enforces its (signed) i16 range — value 200 fits TINYINT but
# we widen to SMALLINT, so 200 is fine.
statement ok
INSERT INTO mixed VALUES (100, 0, 0, 0, NULL, NULL, NULL)

# 7.38.1 S4.2 — cleanup discipline: leave nothing behind.
statement ok
DROP TABLE IF EXISTS mixed CASCADE
