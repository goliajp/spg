# v7.38.18 — an expression index must not stand in for a column index.
#
# This is a defect two SHIPPED builds have, on a plain `C` database, with
# no collation involved. Measured by running the shape below against
# every published image in turn: 7.38.6 through 7.38.15 answer 1,
# **7.38.16 and 7.38.17 answer 0**, and this build answers 1 again.
#
# 7.38.16 is where an expression index began holding the EXPRESSION's
# values instead of the anchor column's. Before that the tree held the
# column's own values, so handing it to a column probe still answered
# correctly — which is why fifteen releases look clean and the fix that
# improved the index is what exposed the lookup behind it.
#
# The first note here said "the shipped build has", singular and
# undated, which is a claim about every release ever made. It was
# written from reading the code rather than from running the images, and
# it was wrong.
#
# Three rows:
#
#   WHERE s = 'Row7'                              1
#   CREATE INDEX ix_expr ON ix((lower(s)))
#   WHERE s = 'Row7'                              0     <-- one row gone
#
# `Table::index_on` returned the first B-tree whose `column_position`
# matched, and an expression index carries the anchor column there. Its
# tree holds `lower(s)`, so a probe built from the column's own value
# asks it a question its keys cannot answer, and the empty answer reads
# exactly like "no matching rows".
#
# v7.38.16 fixed this shape for GIN — "an index answered a question its
# keys could not answer, and the caller read the empty result as the
# answer" — and the B-tree copy of it was two lines away in the same
# function.
#
# Expectations from PG 18.4 with `enable_seqscan=off`, so the oracle
# really used its index: 1 before the index and 1 after.
#
# The lower-case row is the control. It matches by coincidence — its
# value and `lower()` of it are the same string — so a fixture built
# only from lower-case data passes with the defect present.

statement ok
CREATE TABLE ei(s text)

statement ok
INSERT INTO ei VALUES ('Row7'),('row8'),('ROW9')

query I
SELECT count(*) FROM ei WHERE s = 'Row7'
----
1

statement ok
CREATE INDEX ei_expr ON ei((lower(s)))

query I
SELECT count(*) FROM ei WHERE s = 'Row7'
----
1

query I
SELECT count(*) FROM ei WHERE s = 'row8'
----
1

query I
SELECT count(*) FROM ei WHERE s = 'ROW9'
----
1

# The expression index itself still answers its own question, through
# the seek written for it. This stops an EXPRESSION index standing in
# for a COLUMN one; it does not retire the expression index.
query I
SELECT count(*) FROM ei WHERE lower(s) = 'row7'
----
1

query I
SELECT count(*) FROM ei WHERE lower(s) = 'row9'
----
1

statement ok
DROP TABLE ei
