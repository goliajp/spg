# v7.38.18 (S0) — a collated index that is actually USED must give the
# scan's answer.
#
# `v73818_locale_collation_index.test` pins the same agreement on six
# rows, where every seek is declined by the cost cap and both halves are
# really scans. That file proves the answers; this one proves them at a
# size where the index is read — `idx_scan` rises for the equality, the
# IN list and the BETWEEN on this table, and the answers do not move.
#
# The index holds ICU sort keys, which only the engine can produce, so
# `Table::add_index` leaves its tree EMPTY and `Table::index_on` declines
# an unfilled one. An empty tree answers no rows to everything, which is
# indistinguishable from a correct answer — the reason that decline lives
# in one place rather than at each of the dozen seeks.

statement ok
CREATE TABLE lcs(x text COLLATE "en_US.utf8")

