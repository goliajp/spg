statement ok
CREATE INDEX lcs_ix ON lcs(x)

query T
SELECT x FROM lcs WHERE x = 'apple'
----
apple

query T
SELECT x FROM lcs WHERE x BETWEEN 'b' AND 'd' ORDER BY x
----
Bob
client

query T
SELECT x FROM lcs WHERE x IN ('Bob','zebra','DateStyle') ORDER BY x
----
Bob
DateStyle

# The rows added after the index exists are maintained incrementally
# through the same supplied-key channel, not by a rebuild.
statement ok
INSERT INTO lcs VALUES ('Charlie'),('bravo')

query T
SELECT x FROM lcs WHERE x BETWEEN 'b' AND 'd' ORDER BY x
----
Bob
bravo
Charlie
client

# An UPDATE rewrites rows and retires the index; the next statement that
# needs it refreshes it. Without that, this answers nothing at all.
statement ok
UPDATE lcs SET x = 'Delta' WHERE x = 'bravo'

# `Delta` is NOT in `[b, d]`: it folds to `delta`, which is past `d`.
# This expectation read `Bob Charlie client Delta` when it was written
# from reasoning; PG 18.4 says `Bob Charlie client` and SPG already
# agreed. Written from the oracle now, like the rest.
query T
SELECT x FROM lcs WHERE x BETWEEN 'b' AND 'd' ORDER BY x
----
Bob
Charlie
client

statement ok
DELETE FROM lcs WHERE x = 'Charlie'

query T
SELECT x FROM lcs WHERE x BETWEEN 'b' AND 'd' ORDER BY x
----
Bob
client

statement ok
DROP TABLE lcs
