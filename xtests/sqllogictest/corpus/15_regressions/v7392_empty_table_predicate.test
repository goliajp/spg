# v7.39.2 — an unknown column in a predicate, over an EMPTY table.
#
# The projection resolves its names before the scan; a predicate only
# met them per row, so `SELECT a FROM t WHERE nosuch = 1` answered zero
# rows and no error over an empty table, and raised over the same table
# with one row in it. PostgreSQL 18.6 and MySQL 9.7.2 both refuse it
# whatever the row count — a typo'd predicate passed a test written
# against an empty fixture and failed in production.

# The runner asserts THAT a statement errors, not its wording; the exact
# sentences above are pinned in the Rust e2e suite, where an ablation can
# bite them. What this file adds is the SQL itself, running in the gate.

statement ok
CREATE TABLE ec (a INT, b TEXT)

# Empty, and every clause still refuses the name.
# expects: column "nosuch" does not exist
statement error
SELECT a FROM ec WHERE nosuch = 1

# expects: column "nosuch" does not exist
statement error
SELECT a FROM ec ORDER BY nosuch

# expects: column "nosuch" does not exist
statement error
SELECT a FROM ec GROUP BY nosuch

# expects: column "nosuch" does not exist
statement error
SELECT a FROM ec GROUP BY a HAVING nosuch > 1

# A qualified reference keeps its alias, unquoted, as PG prints it.
# expects: column m.nope does not exist
statement error
SELECT a FROM ec m WHERE m.nope = 1

# The controls: a real column still runs, and a system column is not
# in the table's list but is a perfectly good predicate.
query I
SELECT count(*) FROM ec WHERE a = 1
----
0

query I
SELECT count(*) FROM ec WHERE ctid = '(0,4)'::tid
----
0

statement ok
DROP TABLE ec
