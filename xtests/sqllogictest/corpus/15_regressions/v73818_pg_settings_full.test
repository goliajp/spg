# v7.38.18 (C5) — the three surfaces that report a configuration
# parameter now agree, and they agree with PostgreSQL 18.4.
#
# Before this, for one parameter on one session:
#
#   SHOW archive_command                      -> ''  (it exists)
#   SET archive_command = 'x'                 -> cannot be changed now
#   pg_settings WHERE name='archive_command'  -> 0 rows (it does not)
#
# Two surfaces said the parameter was real and the third said it was
# not, for 367 of PG's 398 names. Every expectation below was read from
# a live PG 18.4.
#
# v7.40.12 — 398 -> 399. The number moved because the inventory was
# wrong in two places that happened to cancel: SPG was missing PG's
# `output_plugin_libraries` and was publishing an internal
# `__spg_session_user` key as a row. Over the wire, where that key is
# always set, the count read 399 and looked right; embedded it read 398
# and looked right against this line. Neither was PG's list.
#
# The count is the weakest possible judge of an inventory, and it had
# just proved it, so this was settled name by name against a live
# PG 18.6 instead: `SELECT name FROM pg_settings ORDER BY 1` on both
# engines, diffed, ZERO names on either side. `SHOW ALL` returns the
# same 399 names on both, too — one inventory, three surfaces, still
# agreeing.

query I
SELECT count(*) FROM pg_settings
----
399

# The name round 474 chose as its example of a knob worth hiding. It was
# never hidden — SHOW answered for it the whole time.
query TTT
SELECT name, setting, source FROM pg_settings WHERE name = 'enable_seqscan'
----
enable_seqscan
on
default

query T
SHOW enable_seqscan
----
on

# What separates a parameter SPG acts on from one it merely reports is
# `source`, which is the distinction PG draws with the same column.
query TTT
SELECT name, setting, source FROM pg_settings WHERE name = 'archive_command'
----
archive_command
(empty)
default

# A default carrying a unit is rendered TWO ways by PG and both are
# load-bearing: `pg_settings` reports the bare count beside its unit,
# `current_setting` the human form. Collapsing them into one (which this
# work did, briefly) makes `current_setting('max_wal_size')` answer 1024.
query TTT
SELECT setting, unit, vartype FROM pg_settings WHERE name = 'max_wal_size'
----
1024
MB
integer

query T
SELECT current_setting('max_wal_size')
----
1GB

query TT
SELECT setting, unit FROM pg_settings WHERE name = 'work_mem'
----
4096
kB

query T
SELECT current_setting('work_mem')
----
4MB

# PG's own one-line description, which `SHOW ALL` shows in its third
# column. SPG used to put the CATEGORY there under a heading reading
# `description`.
query T
SELECT short_desc FROM pg_settings WHERE name = 'enable_seqscan'
----
Enables the planner's use of sequential-scan plans.

# A SET on a parameter outside SPG's own list produces ONE row, not two.
# It produced two the first time this landed: the trailing "session-set
# parameters we do not know about" loop no longer knew about them.
statement ok
SET random_page_cost = 3

query TTT
SELECT name, setting, source FROM pg_settings WHERE name = 'random_page_cost'
----
random_page_cost
3
session

# And a name PG does not have is still not a row.
query I
SELECT count(*) FROM pg_settings WHERE name = 'nosuchknob'
----
0

# PG 18.4 answers `SHOW is_superuser` and yet has NO pg_settings row for
# it. That asymmetry is PG's, so it is SPG's — and it is why the count
# above is not simply "every name SHOW answers".
query I
SELECT count(*) FROM pg_settings WHERE name = 'is_superuser'
----
0

query T
SHOW is_superuser
----
on

# v7.40.12 — `session_authorization` is the second name shaped that way,
# measured the same way on PG 18.6: `SHOW session_authorization` answers
# the login identity and `pg_settings` has no row for it. SPG answered
# `unrecognized configuration parameter` while `SELECT session_user` on
# the same session answered correctly — one identity, two surfaces, one
# of them denying the name existed.
query I
SELECT count(*) FROM pg_settings WHERE name = 'session_authorization'
----
0

query I
SELECT count(*) FROM (SELECT session_user) t WHERE session_user IS NOT NULL
----
1

# v7.40.12 — DEFERRABLE was consumed and dropped by the parser, so a
# transaction that asked for it was told nothing had happened. Measured
# on PG 18.6: off by default, on inside the block, off again after.
query T
SHOW transaction_deferrable
----
off

statement ok
BEGIN DEFERRABLE

query T
SHOW transaction_deferrable
----
on

statement ok
ROLLBACK

query T
SHOW transaction_deferrable
----
off
