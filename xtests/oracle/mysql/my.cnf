# MySQL 8 oracle config — fast test mode + bin collation.
#
# `utf8mb4_bin` mirrors PG's C-locale comparison semantics on text:
# any case- / accent-folding diff vs SPG would otherwise need a
# per-fixture adjust_*() rule.

[mysqld]
innodb_flush_log_at_trx_commit = 0
innodb_flush_method            = nosync
sql_mode                       = STRICT_ALL_TABLES,NO_ENGINE_SUBSTITUTION
character_set_server           = utf8mb4
collation_server               = utf8mb4_bin
