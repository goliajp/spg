-- sentori ingest, the "issue already exists" path with a user key:
-- self-hosted/server/src/pipeline.rs `ingest`, statement for statement.
\set fp random(1, :issues)
\set u random(1, :users)
BEGIN;
SELECT id AS iid, status, resolved_in_release, resolved_at FROM issues WHERE project_id = '00000000-0000-0000-0000-000000000001' AND fingerprint = 'fp' || :fp FOR UPDATE \gset
UPDATE issues SET last_seen = GREATEST(last_seen, now()), last_environment = 'production', last_release = '1.4.2' WHERE id = :iid;
UPDATE issues SET event_count = event_count + 1 WHERE id = :iid;
INSERT INTO issue_user_hits (issue_id, user_key, hit_count, last_hit) VALUES (:iid, 'u' || :u, 1, now()) ON CONFLICT (issue_id, user_key) DO UPDATE SET hit_count = issue_user_hits.hit_count + 1, last_hit = now() RETURNING hit_count \gset
UPDATE issues SET users_count = (SELECT COUNT(*) FROM issue_user_hits WHERE issue_id = :iid), max_per_user = GREATEST(max_per_user, :hit_count) WHERE id = :iid;
INSERT INTO events (id, project_id, issue_id, kind, platform, occurred_at, release, environment, user_key, payload) VALUES (gen_random_uuid(), '00000000-0000-0000-0000-000000000001', :iid, 'error', 'ios', now(), '1.4.2', 'production', 'u' || :u, '{"exception":{"type":"TypeError","value":"Cannot read properties of undefined (reading ''id'')"},"stack":[{"fn":"render0","file":"app/screens/Home.tsx","line":10,"col":0},{"fn":"render1","file":"app/screens/Home.tsx","line":11,"col":3},{"fn":"render2","file":"app/screens/Home.tsx","line":12,"col":6},{"fn":"render3","file":"app/screens/Home.tsx","line":13,"col":9},{"fn":"render4","file":"app/screens/Home.tsx","line":14,"col":12},{"fn":"render5","file":"app/screens/Home.tsx","line":15,"col":15},{"fn":"render6","file":"app/screens/Home.tsx","line":16,"col":18},{"fn":"render7","file":"app/screens/Home.tsx","line":17,"col":21},{"fn":"render8","file":"app/screens/Home.tsx","line":18,"col":24},{"fn":"render9","file":"app/screens/Home.tsx","line":19,"col":27},{"fn":"render10","file":"app/screens/Home.tsx","line":20,"col":30},{"fn":"render11","file":"app/screens/Home.tsx","line":21,"col":33}],"device":{"model":"iPhone15,2","os":"iOS 18.1"},"breadcrumbs":["nav Home","tap Profile","net GET /api/me 200"]}') ON CONFLICT (id) DO NOTHING;
COMMIT;
